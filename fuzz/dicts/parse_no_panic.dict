# EPT wire-format vocabulary (see test-data/*.ept for real samples).
kw_begin="BEGIN"
kw_end="END"
kw_data="DATA"
kw_stored="STORED"
kw_encrypted="ENCRYPTED"
kw_conflict="CONFLICT"
kw_ours="OURS"
kw_theirs="THEIRS"
kw_chain="CHAIN"
sep_left="// <("
sep_right=")>"
word="Agent_007"
word_ct="ct"
key_pbkdf="pbkdf:"
key_cipher="cipher:"
key_compress="compress:"
pbkdf_argon2="pbkdf:$argon2$m=16,p=1,t=1$AQIDBAUGBwg="
pbkdf_pbkdf2="pbkdf:$pbkdf2-sha512$i=1$AQIDBAUGBwg="
pbkdf_scrypt="pbkdf:$scrypt$ln=2,p=1,r=1$AQIDBAUGBwg="
cipher_siv="cipher:aes-256-siv"
cipher_gcm="cipher:aes-256-gcm$iv=AQIDBAUGBwgJEBES"
hex_low="0123456789abcdef"
b64="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
