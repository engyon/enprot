---
import Base from "./Base.astro";

const { frontmatter } = Astro.props;
---

<Base title={`${frontmatter.title} · enprot`}>
  <article
    class="prose prose-lg max-w-none
           prose-headings:font-bold prose-headings:text-enprot-ink
           prose-a:text-enprot-accent
           prose-code:before:content-none prose-code:after:content-none
           prose-pre:bg-enprot-ink prose-pre:text-enprot-paper"
  >
    <h1 class="text-3xl font-bold mb-3">{frontmatter.title}</h1>
    <slot />
  </article>
</Base>
